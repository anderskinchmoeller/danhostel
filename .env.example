# Kopiér til .env og udfyld. Filen må ikke i versionsstyring.

# Login til dashboardet. Sæt begge — ellers står servicen åben.
RMS_USER=hotel
RMS_PASSWORD=skift-mig

# Valgfrit: mappe hvor Picasso lægger sin natlige CSV-eksport
# RMS_CSV_INBOX=/data/inbox

# Picasso — udfyldes når AK Techotel har bekræftet API-adgang
# PICASSO_BASE_URL=https://api.example-techotel.dk
# PICASSO_API_KEY=
# PICASSO_PROPERTY_ID=

# Lighthouse rate shopping — udfyldes når abonnementet kører
# LIGHTHOUSE_BASE_URL=
# LIGHTHOUSE_API_KEY=
# LIGHTHOUSE_PROPERTY_ID=
